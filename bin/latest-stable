#!/usr/bin/env bash
set -euo pipefail

plugin_dir=$(CDPATH='' cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
query=${1:-}
"$plugin_dir/bin/list-all" | python3 -c 'import sys
query = sys.argv[1]
versions = [line.strip() for line in sys.stdin if line.strip() and line.strip().startswith(query)]
if versions:
    print(versions[-1])
else:
    print("arinsal: no stable release matches the requested version", file=sys.stderr)
    sys.exit(1)' "$query"
